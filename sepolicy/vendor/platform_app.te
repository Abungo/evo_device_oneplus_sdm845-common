hal_client_domain(platform_app, hal_ifaa)

binder_call(platform_app, hal_ifaa_default)

# Allow apps (platform_app, system_app, untrusted apps) to read telemetry sysfs nodes
r_dir_file(platform_app, vendor_sysfs_battery_supply)
r_dir_file(platform_app, vendor_sysfs_kgsl)

r_dir_file(system_app, vendor_sysfs_battery_supply)
r_dir_file(system_app, vendor_sysfs_kgsl)

r_dir_file(untrusted_app, vendor_sysfs_battery_supply)
r_dir_file(untrusted_app, vendor_sysfs_kgsl)

r_dir_file(shell, vendor_sysfs_battery_supply)
r_dir_file(shell, vendor_sysfs_kgsl)
